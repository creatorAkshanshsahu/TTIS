<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="10dp" android:padding="16dp" android:orientation="vertical"
    android:gravity="center_horizontal" android:focusable="true" android:clickable="true"
    android:background="@drawable/card_bg">
    <ImageView android:id="@+id/logo" android:layout_width="96dp" android:layout_height="96dp" android:scaleType="fitCenter"/>
    <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:gravity="center" android:maxLines="1" android:ellipsize="end"
        android:textColor="#FFFFFF" android:textSize="15sp" android:fontFamily="sans-serif-medium"/>
</LinearLayout>
